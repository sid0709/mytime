# Work-quality mix (hands-on vs feeds)
#
# Key+click share of volume below QUALITY_HANDS_ON_THRESHOLD is treated as
# social/browsing and scored near QUALITY_BROWSING_TARGET (~40–50%).
# Typing and gaming sit above the threshold and keep ~100% entropy quality.
#
# Raise QUALITY_HANDS_ON_THRESHOLD to be stricter (more minutes look like browsing).
# Lower QUALITY_BROWSING_TARGET to pull feeds even lower.

QUALITY_HANDS_ON_THRESHOLD=0.25
QUALITY_BROWSING_TARGET=0.45
# Live Detection-board window (20 one-second samples). Idle seconds average in as 0%.
QUALITY_LIVE_WINDOW_MS=20000
# Skip activity SQLite writes when the last closed 30s slot's mean quality is below this.
# Browsing (~40–50%) still persists; idle-heavy slots do not. Live sidecar still records.
QUALITY_PERSIST_MIN=0.25

